{
  "name": "distributed-wagering-processor",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:prod": "bun run dist/main.js",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:int": "bun test tests/integration",
    "test:concurrency": "bun test tests/concurrency",
    "test:load": "bun run tests/load/load-test.ts",
    "migration:create": "bunx mikro-orm migration:create --config=./src/infrastructure/database/mikro-orm.config.ts",
    "migration:up": "bun run scripts/migrate.ts",
    "migration:down": "bunx mikro-orm migration:down --config=./src/infrastructure/database/mikro-orm.config.ts",
    "migration:list": "bunx mikro-orm migration:list --config=./src/infrastructure/database/mikro-orm.config.ts"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/infrastructure/database/mikro-orm.config.ts"
    ]
  },
  "devDependencies": {
    "@mikro-orm/seeder": "^7.1.12",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/uuid": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jiti": "^2.7.0",
    "pg-types": "^4.1.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1114.0",
    "@mikro-orm/cli": "^7.1.12",
    "@mikro-orm/core": "^7.1.12",
    "@mikro-orm/migrations": "^7.1.12",
    "@mikro-orm/nestjs": "^7.0.2",
    "@mikro-orm/postgresql": "^7.1.12",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "decimal.js": "^10.6.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2"
  }
}