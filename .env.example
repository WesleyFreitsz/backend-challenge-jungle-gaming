# ===================================================
# Jungle Gaming — Distributed Wagering Processor ENV
# ===================================================

NODE_ENV=development
PORT=3000

# Database Configuration (matches docker-compose.yml port mapping 5433:5432)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=wagering
DATABASE_USER=wagering_user
DATABASE_PASSWORD=wagering_secret_pass

# LocalStack SQS Configuration
AWS_REGION=us-east-1
AWS_SQS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# SQS Queue URLs
AWS_SQS_INGRESS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
AWS_SQS_EGRESS_QUEUE_URL=http://localhost:4566/000000000000/wager-transaction-events.fifo
AWS_SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo

# Workers Configuration
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=20
PENDING_REFERENCE_TTL_MS=60000
