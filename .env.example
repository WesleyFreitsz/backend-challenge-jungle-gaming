# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_NAME=wagering
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=wagering_user
DATABASE_PASSWORD=wagering_secret_pass

# AWS / LocalStack SQS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SQS_ENDPOINT=http://localhost:4566

# SQS Queues
SQS_WAGER_TRANSACTIONS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-transaction-events.fifo
SQS_DLQ_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo

# Background Workers
PENDING_REFERENCE_TTL_MS=60000
